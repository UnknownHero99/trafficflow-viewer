# Copy to .env next to docker-compose.yml and adjust.

# Image built by GitHub Actions: ghcr.io/<github user, lower case>/<repo name>:latest
TFV_IMAGE=ghcr.io/unknownhero99/trafficflow-viewer:latest

# How often (seconds) to check for a new image
UPDATE_INTERVAL=300

TZ=Europe/Ljubljana

# Port for the web UI on this server
TFV_WEB_PORT=8321

# Optional app agent: shows which program/container on this server caused its traffic.
# Uncomment both lines; the token is any long random string (e.g. `openssl rand -hex 24`).
# COMPOSE_PROFILES=agent
# TFV_AGENT_TOKEN=
# Agent on a different server than the viewer? Point it at the viewer:
# TFV_AGENT_URL=http://192.168.10.10:8321
